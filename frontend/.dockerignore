# Build context for the production web image.
# Everything that is developer-local, generated, or secret must stay out of the image.

# Local environment. .env.local on a developer laptop points VITE_AETHER_API_ORIGIN at
# localhost; if it reached the builder the baked bundle would call the wrong origin.
.env
.env.*
!.env.example

# Dependencies and build output are produced inside the image, never copied in.
node_modules
dist
.next
.vinext
.wrangler
.sites-runtime
out
coverage
tsconfig.tsbuildinfo

# Tooling / VCS / editor and agent state, at any depth: a stray .omc/ or .claude/ directory left
# inside public/ is copied verbatim into dist/client and the static file cache then fails on it.
**/.git
.gitignore
.github
**/.omc
**/.agents
**/.codex
**/.claude
**/.hallmark
**/.openai/*.log
**/.DS_Store
*.log
npm-debug.log*

# Keys must never enter a build context.
*.pem
*.key
*.crt
